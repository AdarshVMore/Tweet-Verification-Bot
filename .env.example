# Twitter API Configuration
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Blockchain RPC URLs
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_infura_project_id
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/your_infura_project_id
ARBITRUM_RPC_URL=https://arbitrum-mainnet.infura.io/v3/your_infura_project_id
BSC_RPC_URL=https://bsc-dataseed1.binance.org

# The Graph Token API & Substreams
GRAPH_TOKEN_API_KEY=your_graph_token_api_key_here
GRAPH_API_KEY=your_graph_api_key_here

# Substreams Configuration
SUBSTREAMS_ENDPOINT=https://mainnet.eth.streamingfast.io:443
USE_SUBSTREAMS_FIRST=true

# Pyth Network
PYTH_ENDPOINT=https://hermes.pyth.network
PYTH_BENCHMARK_ENDPOINT=https://benchmarks.pyth.network

# MCP (Model Context Protocol) Configuration
ENABLE_MCP_REASONING=false
MCP_SERVER_URL=http://localhost:3001

# Bot Configuration
PORT=3000
LOG_LEVEL=info
ENABLE_AUDIT_LOGGING=true